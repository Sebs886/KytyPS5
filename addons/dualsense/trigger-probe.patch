+namespace {
+
+// ---- trigger effect probe ------------------------------------------------------------------------
+// Demon's Souls carries a trigger preset system of its own (controller_triggerEffectEnable,
+// CPOLdrPadTriggerEffectPreset, SendLeftTrigger) and this port implements scePadSetTriggerEffect, but
+// nothing said whether the game ever calls it and whether the host pad takes the result. These lines
+// answer the two halves apart: "asked" is the game's call, "host"/"send" is what SDL did with it.
+// std::printf, not LOGF: the release build keeps the console's log silent.
+//
+// A game that re-sets an effect every frame would bury the log, so a request identical to the one
+// printed last is only counted, and the probe stops after this many lines.
+constexpr uint32_t TRIGGER_PROBE_MAX = 64;
+
+struct TriggerProbe {
+	uint64_t calls        = 0;
+	uint32_t printed      = 0;
+	uint32_t repeated     = 0;
+	uint32_t last_request = 0xffffffffu;
+	int      last_send    = -999;
+};
+
+TriggerProbe g_trigger_probe;
+
+uint32_t TriggerProbeRequest(const PadTriggerEffectParam& param) {
+	uint32_t   hash = 2166136261u;
+	const auto mix  = [&hash](uint32_t value) { hash = (hash ^ value) * 16777619u; };
+
+	mix(param.trigger_mask);
+	for (const auto& command: param.command) {
+		mix(command.mode);
+		for (const auto value: command.data) {
+			mix(value);
+		}
+	}
+	return hash;
+}
+
+void TriggerProbeCommand(const PadTriggerEffectCommand& command, char* text, size_t size) {
+	std::snprintf(text, size, "mode=%u data=%02x %02x %02x %02x",
+	              static_cast<unsigned>(command.mode), static_cast<unsigned>(command.data[0]),
+	              static_cast<unsigned>(command.data[1]), static_cast<unsigned>(command.data[2]),
+	              static_cast<unsigned>(command.data[3]));
+}
+
+// pad_type: -1 when no host pad is open, otherwise what SDL_GameControllerGetType answers.
+// send: the result of SDL_GameControllerSendEffect, or -999 when nothing was sent at all (no pad, a
+// pad that is not a DualSense, or an effect that never converted).
+void TriggerProbeReport(const PadTriggerEffectParam& param, bool converted, int pad_type, int send) {
+	auto& probe = g_trigger_probe;
+
+	probe.calls++;
+	if (probe.printed >= TRIGGER_PROBE_MAX) {
+		return;
+	}
+	const uint32_t request = TriggerProbeRequest(param);
+	if (request == probe.last_request && send == probe.last_send) {
+		probe.repeated++;
+		return;
+	}
+	probe.last_request = request;
+	probe.last_send    = send;
+	probe.printed++;
+
+	char left[64]  = {};
+	char right[64] = {};
+	char sent[24]  = {};
+	TriggerProbeCommand(param.command[0], left, sizeof(left));
+	TriggerProbeCommand(param.command[1], right, sizeof(right));
+	if (send == -999) {
+		std::snprintf(sent, sizeof(sent), "not sent");
+	} else {
+		std::snprintf(sent, sizeof(sent), "%d", send);
+	}
+	const char* host = "no pad";
+	if (pad_type == SDL_CONTROLLER_TYPE_PS5) {
+		host = "DualSense";
+	} else if (pad_type >= 0) {
+		host = "not a DualSense";
+	}
+
+	std::printf(
+	    "Pad: trigger effect #%llu mask=0x%02x converted=%s host=%s send=%s left[%s] right[%s]\n",
+	    static_cast<unsigned long long>(probe.calls), static_cast<unsigned>(param.trigger_mask),
+	    converted ? "yes" : "no", host, sent, left, right);
+	if (probe.printed == TRIGGER_PROBE_MAX) {
+		std::printf("Pad: trigger effect: %u lines logged, further requests are only counted\n",
+		            TRIGGER_PROBE_MAX);
+	}
+	std::fflush(stdout);
+}
+
+} // namespace
+
 void Initialize() {
 	EXIT_IF(g_controller != nullptr);
 
+	// Says the probe is in this build even when the game never calls the function it watches: an empty
+	// log then means "the game did not call it", not "this exe has no probe".
+	std::printf("Pad: trigger effect probe ready (scePadSetTriggerEffect 2JgFB2n9oUM, "
+	            "scePadGetTriggerEffectState znaWI0gpuo8)\n");
+	std::fflush(stdout);
+
 	g_controller = new GameController;
 	g_controller->Connect(HOST_INPUT_CONTROLLER_ID);
 }
